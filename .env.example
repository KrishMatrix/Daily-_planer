# ── Database (PostgreSQL) ────────────────────────────────────────────────
# Pooled connection used by the app (e.g. Neon/Supabase pooler URL on Vercel)
DATABASE_URL="postgresql://planner:planner@localhost:5433/lifeplanner?schema=public"
# Direct (non-pooled) connection used by `prisma migrate`. Same as DATABASE_URL locally.
DIRECT_URL="postgresql://planner:planner@localhost:5433/lifeplanner?schema=public"

# ── Accounts ─────────────────────────────────────────────────────────────
# Set to "false" after creating your own account to close public sign-ups.
ALLOW_SIGNUP="true"

# ── AI (server-side only — never exposed to the browser) ─────────────────
# Provider: "openai" (Responses API) or "compatible" (any OpenAI-compatible Chat Completions server)
AI_PROVIDER="openai"
# Your OpenAI key — https://platform.openai.com/api-keys. Never commit a real key.
OPENAI_API_KEY=""
# Default model for every user (each user can override it in AI Settings).
# gpt-5-mini is the proven default. gpt-6-luna was ~5x cheaper per request in testing
# ($0.10 / $0.50 per 1M input / output tokens vs $0.25 / $2.00) and handled the planner's tools well.
OPENAI_MODEL="gpt-5-mini"
# Hidden reasoning is billed as output: "low" keeps it small. Use "off" for models without reasoning.
OPENAI_REASONING_EFFORT="low"
# Optional override, e.g. a proxy endpoint
OPENAI_BASE_URL="https://api.openai.com/v1"
# Only for AI_PROVIDER="compatible" (OpenRouter, Groq, Ollama, LM Studio…)
AI_BASE_URL=""
AI_API_KEY=""
AI_MODEL=""

# ── Weather (Open-Meteo — free for non-commercial use, no key needed) ────
# Optional overrides, e.g. a self-hosted Open-Meteo instance or a commercial customer URL.
# WEATHER_FORECAST_URL="https://api.open-meteo.com/v1/forecast"
# WEATHER_GEOCODE_URL="https://geocoding-api.open-meteo.com/v1/search"

# ── Push notifications (Web Push / VAPID) ────────────────────────────────
# Generate with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"

# ── Scheduled jobs ───────────────────────────────────────────────────────
# Shared secret for /api/cron/reminders (Vercel Cron sends it as a Bearer token)
CRON_SECRET="change-me-to-a-long-random-string"
